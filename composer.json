{
    "name": "endereco/plentyone-client",
    "description": "QA tooling for the EnderecoPlentyOneClient plugin. Not used at runtime - PlentyONE deploys the raw src/ and resources/ files directly, without composer's autoloader.",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "find src resources/lib -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "qa": [
            "@lint",
            "@cs"
        ]
    }
}
